# Database Connection (Supabase PostgreSQL)
# Pooled connection string for application runtime queries (Transaction pooler on port 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?pgbouncer=true"
# Direct connection string for migrations and introspection (Port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Institution Email Restriction (Only this domain allowed for signup)
INSTITUTION_EMAIL_DOMAIN="kiit.ac.in"

# Roll Number Parser Configuration (Regex applied on the local-part of the institutional email)
# e.g. for "21051234@kiit.ac.in" or "aarav.2105123@kiit.ac.in"
ROLL_NUMBER_REGEX="^([a-zA-Z0-9._-]+)"
ROLL_NUMBER_CAPTURE_GROUP=1

# Cron Sync Secret for background synchronization endpoint (/api/cron/sync)
CRON_SECRET="your-secure-cron-secret-token"

# Coding Platform Providers
# LeetCode Configuration
LEETCODE_PROVIDER="official"
LEETCODE_API_BASE_URL="https://leetcode.com/graphql"

# Codeforces Configuration (Official API)
CODEFORCES_API_BASE_URL="https://codeforces.com/api"

# CodeChef Configuration
# The previous third-party Vercel API (codechef-api.vercel.app) is dead.
# The tracker now self-hosts the parser: it scrapes the public CodeChef
# profile page (https://www.codechef.com/users/{handle}) directly - no
# external base URL or API key required. Heatmap + rating come from the
# page's embedded script variables; the daily submission heatmap is stored
# in PlatformSnapshot.rawMetadata.heatmap.
# NOTE: CodeChef exposes no individual solved-problem list, so sync capability
# is PARTIAL by design: aggregate counts are never expanded into solved records.
CODECHEF_PROVIDER="self"
# Optional override (e.g. for tests or a proxy); defaults to https://www.codechef.com
CODECHEF_SCRAPE_BASE_URL=""

# Platform Sync Minimum Interval (in minutes) to prevent rate limiting
PLATFORM_SYNC_MIN_INTERVAL_MINUTES=10
